            const data = snapshot.val();
            if (data) {
                fbUserCurrentBalance = data.balance || 0;
                fbLastSpinTime = data.lastSpinTime || null;
                fbSessionStartTime = data.sessionStart || null;
                if (data.phone) userPhone = data.phone;
            } else {
                // Initialize default user record in Firebase
                fbSessionStartTime = Date.now();
                userRef.set({
                    userId: userId,
                    phone: userPhone,
                    balance: 0,
                    sessionStart: fbSessionStartTime,
                    lastSpinTime: null
                });
            }

            document.getElementById("fbUserBalance").innerText = fbUserCurrentBalance.toFixed(2);
            evaluateStateAndTimers();
        });

        // Sync Live Recent Winners Ticker Stream from Firebase
        const winnersRef = database.ref('recent_winners').limitToLast(5);
        winnersRef.on('value', (snapshot) => {
            const tickerList = document.getElementById("tickerList");
            if (!tickerList) return;
            tickerList.innerHTML = "";

            const items = [];
            snapshot.forEach(child => {
                items.unshift(child.val());
            });

            if (items.length === 0) {
                // Fallback display if database is empty initially
                renderTickerItem("017******19", 500);
                renderTickerItem("019******43", 300);
                renderTickerItem("018******82", 3);
            } else {
                items.forEach(w => {
                    renderTickerItem(w.phone || "017******00", w.amount || 1);
                });
            }
        });

        // --- 2. WHEEL CONFIGURATION ---
        const slices = [
            { label: "৳ ১", value: 1, weight: 35, bg: "#FFFDF0" },
            { label: "৳ ৩", value: 3, weight: 30, bg: "#FFFFFF" },
            { label: "৳ ৫", value: 5, weight: 20, bg: "#FFFDF0" },
            { label: "৳ ৭", value: 7, weight: 12, bg: "#FFFFFF" },
            { label: "৳ ২৫", value: 25, weight: 2, bg: "#FFFDF0" },
            { label: "৳ ১০০", value: 100, weight: 0.7, bg: "#FFFFFF" },
            { label: "৳ ২০০", value: 200, weight: 0.2, bg: "#FFFDF0" },
            { label: "৳ ৫০০", value: 500, weight: 0.1, bg: "#FFFFFF" }
        ];

        let pendingWinAmount = 0;

        function renderTickerItem(phone, amount) {
            const tickerList = document.getElementById("tickerList");
            if (!tickerList) return;
            const newItem = document.createElement("div");
            newItem.className = "flex justify-between items-center text-amber-200 text-[11px] font-mono py-0.5 border-b border-amber-500/10";
            newItem.innerHTML = `<span>${phone}</span><span class="text-amber-400 font-bold">৳ ${amount}.00</span>`;
            tickerList.appendChild(newItem);

            if (tickerList.children.length > 4) {
                tickerList.removeChild(tickerList.firstChild);
            }
        }

        // --- 3. CLAIM REWARD TO FIREBASE ---
        function claimRewardToFirebase() {
            const now = Date.now();
            const newBalance = fbUserCurrentBalance + pendingWinAmount;

            // Update User Profile in Firebase
            userRef.update({
                balance: newBalance,
                lastSpinTime: now
            });

            // Push Winner Notification Entry to Firebase
            database.ref('recent_winners').push({
                userId: userId,
                phone: userPhone,
                amount: pendingWinAmount,
                timestamp: now
            });

            // PostMessage trigger for external container app integration
            if (window.parent) {
                window.parent.postMessage({
                    type: "CLAIM_REWARD",
                    amount: pendingWinAmount
                }, "*");
            }

            closeModal();
        }

        const numSlices = slices.length;
        const sliceAngle = (Math.PI * 2) / numSlices;
        
        const canvas = document.getElementById("wheelCanvas");
        const ctx = canvas.getContext("2d");
        const spinBtn = document.getElementById("spinBtn");
        const claimBtn = document.getElementById("claimBtn");
        const progressBar = document.getElementById("progressBar");

        const gameWheelSection = document.getElementById("gameWheelSection");
        const cooldownSection = document.getElementById("cooldownSection");

        let currentAngle = 0;
        let isSpinning = false;

        const TWELVE_HOURS_MS = 12 * 60 * 60 * 1000;
        const TWENTYFOUR_HOURS_MS = 24 * 60 * 60 * 1000;

        // Audio System
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playTickSound() {
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(700, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(120, audioCtx.currentTime + 0.04);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.04);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.04);
            } catch(e) {}
        }

        function playWinSound() {
            try {
                if (audioCtx.state === 'suspended') audioCtx.resume();
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(0.25, audioCtx.currentTime + idx * 0.09);
                    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.09 + 0.35);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + idx * 0.09);
                    osc.stop(audioCtx.currentTime + idx * 0.09 + 0.35);
                });
            } catch(e) {}
        }

        // Draw Money Bag Icon
        function drawMoneyBag(context, x, y, size) {
            context.save();
            context.translate(x, y);
            context.fillStyle = "#d97706";
            context.beginPath();
            context.arc(0, size * 0.2, size * 0.75, 0, Math.PI * 2);
            context.fill();

            context.fillStyle = "#92400e";
            context.fillRect(-size * 0.4, -size * 0.6, size * 0.8, size * 0.35);

            context.fillStyle = "#fef08a";
            context.font = "bold 9px sans-serif";
            context.textAlign = "center";
            context.textBaseline = "middle";
            context.fillText("৳", 0, size * 0.2);
            context.restore();
        }

        // Draw Fortune Wheel
        function drawWheel() {
            const width = canvas.width;
            const height = canvas.height;
            const centerX = width / 2;
            const centerY = height / 2;
            const outerRadius = width / 2 - 12;
            const innerRadius = 30;

            ctx.clearRect(0, 0, width, height);

            // Outer Rim
            ctx.save();
            ctx.beginPath();
            ctx.arc(centerX, centerY, outerRadius + 8, 0, Math.PI * 2);
            const goldGrad = ctx.createRadialGradient(centerX, centerY, outerRadius, centerX, centerY, outerRadius + 10);
            goldGrad.addColorStop(0, '#ffe57f');
            goldGrad.addColorStop(0.5, '#ff9800');
            goldGrad.addColorStop(1, '#b71c1c');
            ctx.fillStyle = goldGrad;
            ctx.fill();
            ctx.restore();

            // Draw Slices
            for (let i = 0; i < numSlices; i++) {
                const startAngle = currentAngle + i * sliceAngle;
                const endAngle = startAngle + sliceAngle;

                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.arc(centerX, centerY, outerRadius, startAngle, endAngle);
                ctx.closePath();

                ctx.fillStyle = slices[i].bg;
                ctx.fill();

                ctx.strokeStyle = "#f59e0b";
                ctx.lineWidth = 1.5;
                ctx.stroke();

                ctx.save();
                ctx.translate(centerX, centerY);
                ctx.rotate(startAngle + sliceAngle / 2);

                ctx.fillStyle = "#78350f";
                ctx.font = "bold 13px 'Hind Siliguri', sans-serif";
                ctx.textAlign = "right";
                ctx.textBaseline = "middle";
                ctx.fillText(slices[i].label, outerRadius - 34, 0);

                drawMoneyBag(ctx, outerRadius - 16, 0, 9);
                ctx.restore();
            }

            // Outer Perimeter Lights
            const numLights = 18;
            for (let i = 0; i < numLights; i++) {
                const angle = (i * Math.PI * 2) / numLights;
                const lx = centerX + (outerRadius + 4) * Math.cos(angle);
                const ly = centerY + (outerRadius + 4) * Math.sin(angle);

                ctx.beginPath();
                ctx.arc(lx, ly, 3.5, 0, Math.PI * 2);
                ctx.fillStyle = (Math.floor(Date.now() / 200) + i) % 2 === 0 ? "#ffffff" : "#ffea00";
                ctx.shadowColor = "#ffab00";
                ctx.shadowBlur = 5;
                ctx.fill();
                ctx.shadowBlur = 0;
            }

            // Center Ring Frame
            ctx.beginPath();
            ctx.arc(centerX, centerY, innerRadius + 4, 0, Math.PI * 2);
            ctx.fillStyle = "#d84315";
            ctx.fill();
        }

        // Weighted Random Selector (Small amounts have high odds)
        function getWeightedRandomSliceIndex() {
            const totalWeight = slices.reduce((sum, slice) => sum + slice.weight, 0);
            let randomNum = Math.random() * totalWeight;

            for (let i = 0; i < slices.length; i++) {
                if (randomNum < slices[i].weight) {
                    return i;
                }
                randomNum -= slices[i].weight;
            }
            return 0;
        }

        // Spin Action
        function spinWheel() {
            if (isSpinning) return;

            isSpinning = true;

            const winningIndex = getWeightedRandomSliceIndex();
            const targetSliceCenter = winningIndex * sliceAngle + sliceAngle / 2;
            const arrowAngle = 3 * Math.PI / 2;
            
            let targetAngle = arrowAngle - targetSliceCenter;
            targetAngle = targetAngle % (Math.PI * 2);
            if (targetAngle < 0) targetAngle += Math.PI * 2;

            const fullRotations = 6 * (Math.PI * 2);
            const finalAngle = currentAngle + fullRotations + (targetAngle - (currentAngle % (Math.PI * 2)));

            const spinDuration = 4200;
            const startTime = performance.now();
            const startAngle = currentAngle;
            let lastTickIndex = -1;

            function animateSpin(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / spinDuration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 4);

                currentAngle = startAngle + (finalAngle - startAngle) * easeOut;

                const currentPassedSlice = Math.floor((currentAngle % (Math.PI * 2)) / sliceAngle);
                if (currentPassedSlice !== lastTickIndex) {
                    playTickSound();
                    lastTickIndex = currentPassedSlice;
                }

                drawWheel();

                if (progress < 1) {
                    requestAnimationFrame(animateSpin);
                } else {
                    isSpinning = false;
                    const wonSlice = slices[winningIndex];
                    pendingWinAmount = wonSlice.value;

                    if (typeof confetti === 'function') {
                        confetti({ particleCount: 80, spread: 70, origin: { y: 0.6 } });
                    }
                    playWinSound();

                    setTimeout(() => {
                        showModal("অভিনন্দন! 🎉", `আপনি পেয়েছেন ${wonSlice.label}! এটি ফায়ারবেস ব্যালেন্স যোগ করতে নিচের বাটনে ক্লিক করুন।`);
                        if (progressBar) progressBar.style.width = "100%";
                    }, 300);
                }
            }

            requestAnimationFrame(animateSpin);
        }

        function showModal(title, msg) {
            document.getElementById("modalTitle").innerText = title;
            document.getElementById("modalMsg").innerText = msg;
            document.getElementById("rewardModal").classList.remove("hidden");
        }

        function closeModal() {
            document.getElementById("rewardModal").classList.add("hidden");
            evaluateStateAndTimers();
        }

        // Timer Engine with Firebase Synchronized Expiration Rules
        function evaluateStateAndTimers() {
            const now = Date.now();

            if (fbLastSpinTime) {
                const elapsedSpun = now - fbLastSpinTime;
                if (elapsedSpun < TWENTYFOUR_HOURS_MS) {
                    gameWheelSection.classList.add("hidden");
                    cooldownSection.classList.remove("hidden");
                    
                    document.getElementById("cooldownTitle").innerText = "আজকের অফার শেষ!";
                    document.getElementById("cooldownMsg").innerText = "আপনি আপনার স্পিন সুযোগটি ইতোমধ্যে গ্রহণ করেছেন। ২৪ ঘণ্টা পর আবার পাবেন:";
                    document.getElementById("timerLabel").innerText = "পরবর্তী স্পিন সময়";

                    const remainingCooldown = TWENTYFOUR_HOURS_MS - elapsedSpun;
                    updateClockDisplay(remainingCooldown);
                    return;
                } else {
                    // Reset Spin state after 24h
                    userRef.update({
                        lastSpinTime: null,
                        sessionStart: now
                    });
                }
            }

            const sessionStartMs = fbSessionStartTime || now;
            const elapsedUnspun = now - sessionStartMs;

            if (elapsedUnspun >= TWENTYFOUR_HOURS_MS) {
                userRef.update({ sessionStart: now });
                gameWheelSection.classList.remove("hidden");
                cooldownSection.classList.add("hidden");
            } else if (elapsedUnspun >= TWELVE_HOURS_MS) {
                gameWheelSection.classList.add("hidden");
                cooldownSection.classList.remove("hidden");

                document.getElementById("cooldownTitle").innerText = "অফারটির সময় শেষ!";
                document.getElementById("cooldownMsg").innerText = "১২ ঘণ্টার মধ্যে ক্লেইম না করায় অফারটির মেয়াদ শেষ হয়েছে। নতুন অফার আসবে:";
                document.getElementById("timerLabel").innerText = "রিসেট হতে সময় বাকি";

                const remainingReset = TWENTYFOUR_HOURS_MS - elapsedUnspun;
                updateClockDisplay(remainingReset);
                return;
            } else {
                gameWheelSection.classList.remove("hidden");
                cooldownSection.classList.add("hidden");
                document.getElementById("timerLabel").innerText = "মেয়াদ শেষ হতে বাকি";

                const remainingActiveTime = TWELVE_HOURS_MS - elapsedUnspun;
                updateClockDisplay(remainingActiveTime);
            }
        }

        function updateClockDisplay(ms) {
            const hrs = Math.floor(ms / (1000 * 60 * 60));
            const mins = Math.floor((ms % (1000 * 60 * 60)) / (1000 * 60));
            const secs = Math.floor((ms % (1000 * 60)) / 1000);

            const format = num => num.toString().padStart(2, '0');

            document.getElementById("hours").innerText = format(hrs);
            document.getElementById("minutes").innerText = format(mins);
            document.getElementById("seconds").innerText = format(secs);

            document.getElementById("coolHours").innerText = format(hrs);
            document.getElementById("coolMins").innerText = format(secs);
            document.getElementById("coolSecs").innerText = format(secs);
        }

        setInterval(evaluateStateAndTimers, 1000);

        spinBtn.addEventListener("click", spinWheel);
        claimBtn.addEventListener("click", spinWheel);

        setInterval(() => {
            if (!isSpinning && !gameWheelSection.classList.contains("hidden")) {
                drawWheel();
            }
        }, 200);

        window.onload = function() {
            drawWheel();
            evaluateStateAndTimers();
        };
    </script>
</body>
