        if (firebase.analytics) firebase.analytics();

        // Unique User Identification Logic
        let userId = localStorage.getItem("firebase_wheel_uid");
        if (!userId) {
            userId = "usr_" + Math.random().toString(36).substring(2, 10);
            localStorage.setItem("firebase_wheel_uid", userId);
